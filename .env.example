# Base URL for yati-api. Defaults to the production Azure Function App if unset —
# only needed locally if you're pointing at a different environment (e.g. local func start).
VITE_API_BASE=https://yati-api-7421.azurewebsites.net

# Stripe PUBLISHABLE key (safe to expose client-side — this is not the secret
# key). Get it from the Stripe Dashboard -> Developers -> API keys. Use the
# pk_test_... key while testing, swap to pk_live_... only once you're ready
# to take real payments. This must also be set as an environment variable
# in Vercel (Project Settings -> Environment Variables) for production.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
